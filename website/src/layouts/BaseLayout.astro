---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, url } from '../site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(url('/og-image.jpg'), Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07060c" />
    <link rel="icon" href={url("/favicon.ico")} sizes="48x48" />
    <link rel="icon" href={url("/favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && <link rel="sitemap" href={url("/sitemap-index.xml")} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content="F2F: your design, built exactly" />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {SITE.goatcounter && (
      <script is:inline define:vars={{ code: SITE.goatcounter }}>
        // Anonymous page-view counting (no cookies); skipped when the visitor sends Do Not Track.
        if (navigator.doNotTrack !== '1') {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://gc.zgo.at/count.js';
          s.dataset.goatcounter = 'https://' + code + '.goatcounter.com/count';
          document.head.appendChild(s);
        }
      </script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('is-in');
            // The stagger delay only belongs to the entrance, not to later hover transitions.
            setTimeout(() => ((e.target as HTMLElement).style.transitionDelay = ''), 1200);
            io.unobserve(e.target);
          }),
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
      );
      // Siblings enter in reading order, 70ms apart.
      items.forEach((el) => {
        const i = [...(el.parentElement?.querySelectorAll(':scope > [data-reveal]') ?? [])].indexOf(el);
        el.style.transitionDelay = `${Math.max(0, i) * 70}ms`;
        io.observe(el);
      });

      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.addEventListener('pointermove', (e) => {
          const card = (e.target as Element).closest<HTMLElement>('.spot');
          if (!card) return;
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -48px;
    left: var(--space-m);
    z-index: 200;
    padding: var(--space-s) var(--space-m);
    border-radius: var(--radius-s);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 650;
  }
  .skip-link:focus { top: var(--space-m); }
</style>
