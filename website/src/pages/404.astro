---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — F2F" description="This page does not exist." noindex>
  <section class="container section wrap">
    <span class="code gradient-text">404</span>
    <h1>This layer has no match.</h1>
    <p>The page you are looking for does not exist or has moved.</p>
    <div class="cta-row">
      <a href="/" class="btn btn-primary">Back home</a>
      <a href="/docs" class="btn btn-ghost">Quick start</a>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap { max-width: 640px; text-align: center; display: grid; gap: var(--space-l); justify-items: center; }
  .code { font-family: var(--font-mono); font-size: clamp(4rem, 14vw, 7rem); font-weight: 700; line-height: 1; }
  h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); }
</style>
