---
import { SITE } from '../site';

const year = new Date().getFullYear();
const repo = SITE.repoUrl;

const columns = [
  {
    title: 'Product',
    links: [
      { href: '/how-it-works', label: 'How it works' },
      { href: '/docs', label: 'Get started' },
      { href: '/faq', label: 'FAQ' },
    ],
  },
  {
    title: 'Developers',
    links: [
      { href: '/developers', label: 'Architecture' },
      { href: '/docs#quick-reference', label: 'CLI reference' },
      ...(repo ? [{ href: repo, label: 'Source code', external: true }, { href: `${repo}/issues`, label: 'Report a bug', external: true }] : []),
    ],
  },
  {
    title: 'Trust',
    links: [
      { href: '/privacy', label: 'Privacy' },
      ...(repo ? [{ href: `${repo}/blob/main/LICENSE`, label: `License (${SITE.license})`, external: true }] : []),
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="grid">
      <div class="brand-col">
        <a href="/" class="brand">
          <img src="/logo.webp" alt="" width="40" height="40" loading="lazy" />
          <span>{SITE.name}</span>
        </a>
        <p>{SITE.tagline}</p>
      </div>
      {columns.map((col) => (
        <nav class="col" aria-label={col.title}>
          <h2 class="label">{col.title}</h2>
          <ul role="list">
            {col.links.map((l) => (
              <li>
                <a href={l.href} target={'external' in l ? '_blank' : undefined} rel={'external' in l ? 'noopener' : undefined}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="bottom">
      <span>© {year} {SITE.name}. Open source under {SITE.license}.</span>
      <span class="status"><span class="dot" aria-hidden="true"></span> Runs 100% on your machine</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-4xl);
    padding: var(--space-3xl) 0 var(--space-xl);
    border-top: 1px solid var(--border-glass);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    font-weight: 700;
    font-size: 1.125rem;
  }
  .brand:hover { color: var(--text-primary); }
  .brand img { width: 40px; height: 40px; object-fit: contain; }
  .brand-col p { margin-top: var(--space-m); max-width: 34ch; font-size: 0.9375rem; }

  .col ul { list-style: none; margin-top: var(--space-m); display: grid; gap: var(--space-s); }
  .col a { font-size: 0.9375rem; color: var(--text-label); }
  .col a:hover { color: var(--text-primary); }

  .bottom {
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--border-glass);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-m);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .status { display: inline-flex; align-items: center; gap: var(--space-s); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
    .brand-col { grid-column: 1 / -1; }
  }

  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .bottom { flex-direction: column; text-align: center; }
  }
</style>
