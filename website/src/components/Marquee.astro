---
interface Props {
  items: readonly string[];
  label: string;
}

const { items, label } = Astro.props;
---

<div class="marquee" role="group" aria-label={label}>
  <ul class="track" role="list">
    {items.map((item) => <li>{item}</li>)}
  </ul>
  <ul class="track" role="list" aria-hidden="true">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .marquee {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .track {
    display: flex;
    flex-shrink: 0;
    min-width: 100%;
    align-items: center;
    justify-content: space-around;
    gap: var(--space-2xl);
    padding-right: var(--space-2xl);
    list-style: none;
    animation: slide 38s linear infinite;
  }

  .marquee:hover .track { animation-play-state: paused; }

  li {
    white-space: nowrap;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-secondary);
    transition: var(--morph);
  }
  li:hover { color: var(--text-primary); }

  @keyframes slide { to { transform: translateX(-100%); } }

  @media (prefers-reduced-motion: reduce) {
    .marquee { flex-wrap: wrap; mask-image: none; -webkit-mask-image: none; }
    .track { animation: none; flex-wrap: wrap; justify-content: center; padding-right: 0; }
    .track[aria-hidden='true'] { display: none; }
  }
</style>
