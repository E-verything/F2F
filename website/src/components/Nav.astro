---
import { NAV, SITE } from '../site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="nav-wrap">
  <nav class="nav glass-card" aria-label="Primary">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <img src="/logo.webp" alt="" width="32" height="32" class="logo" />
      <span>{SITE.name}</span>
    </a>

    <ul class="links" role="list">
      {NAV.map((l) => (
        <li>
          <a href={l.href} class:list={['link', { active: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>

    <a href="/docs" class="btn btn-primary nav-cta">Get started</a>

    <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer" data-menu>
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<div id="drawer" class="drawer" data-drawer data-open="false" aria-hidden="true">
  <div class="backdrop" data-close></div>
  <div class="panel glass-card" role="dialog" aria-modal="true" aria-label="Navigation">
    <ul role="list">
      {NAV.map((l) => (
        <li><a href={l.href} class:list={['drawer-link', { active: isActive(l.href) }]}>{l.label}</a></li>
      ))}
      <li><a href="/docs" class="btn btn-primary drawer-cta">Get started</a></li>
    </ul>
  </div>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');

  const setOpen = (open: boolean) => {
    if (!btn || !drawer) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    drawer.dataset.open = String(open);
    drawer.setAttribute('aria-hidden', String(!open));
    document.body.style.overflow = open ? 'hidden' : '';
  };

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  drawer?.querySelector('[data-close]')?.addEventListener('click', () => setOpen(false));
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>

<style>
  .nav-wrap {
    position: sticky;
    top: var(--space-m);
    z-index: 50;
    margin-top: var(--space-m);
    padding: 0 var(--gutter);
  }

  .nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 6px 6px 6px var(--space-l);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l);
    border-radius: var(--radius-pill);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
  }
  .brand:hover { color: var(--text-primary); }
  .logo { width: 32px; height: 32px; object-fit: contain; }

  .links { display: flex; gap: var(--space-xs); list-style: none; }

  .link {
    display: inline-block;
    padding: var(--space-s) var(--space-m);
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-label);
  }
  .link:hover { color: var(--text-primary); background: var(--glass-bg); }
  .link.active { color: var(--text-primary); background: rgba(255, 255, 255, 0.08); }

  .nav-cta { min-height: 40px; padding: 0 var(--space-l); font-size: 0.9375rem; }

  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    border-radius: var(--radius-pill);
  }
  .menu-btn:hover { background: var(--glass-bg); }
  .menu-btn span {
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--text-primary);
    transition: var(--morph);
  }
  .menu-btn[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-btn[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .drawer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
  }
  .drawer[data-open='true'] { pointer-events: auto; }

  .backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .drawer[data-open='true'] .backdrop { opacity: 1; }

  .panel {
    position: absolute;
    top: calc(var(--space-m) + 68px);
    left: var(--gutter);
    right: var(--gutter);
    max-width: 420px;
    margin-left: auto;
    padding: var(--space-l);
    opacity: 0;
    transform: translateY(-12px) scale(0.98);
    transition: var(--morph);
  }
  .drawer[data-open='true'] .panel { opacity: 1; transform: none; }

  .panel ul { list-style: none; display: grid; gap: var(--space-xs); }
  .drawer-link {
    display: block;
    padding: var(--space-m) var(--space-l);
    border-radius: var(--radius-m);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--text-label);
  }
  .drawer-link:hover,
  .drawer-link.active { background: rgba(255, 255, 255, 0.08); color: var(--text-primary); }
  .drawer-cta { width: 100%; margin-top: var(--space-s); }

  @media (max-width: 900px) {
    .links,
    .nav-cta { display: none; }
    .menu-btn { display: inline-flex; }
    .drawer { display: block; }
  }
</style>
